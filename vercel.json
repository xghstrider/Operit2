{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    }
  ],
  "services": {
    "cli": {
      "root": "apps/cli",
      "runtime": "rust"
    },
    "esp32": {
      "root": "apps/esp32",
      "runtime": "rust"
    },
    "pb_sbc01_h3": {
      "root": "apps/pb_sbc01_h3",
      "runtime": "rust"
    },
    "esp32-editor": {
      "root": "tools/esp32-editor",
      "runtime": "node"
    },
    "simulator": {
      "root": "tools/esp32-editor/simulator",
      "runtime": "rust"
    },
    "web-access": {
      "root": "apps/web_access",
      "framework": null,
      "outputDirectory": "build/bundle"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web-access" } }
  ]
}
