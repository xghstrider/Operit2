# Cloudflare Pages header rules for the Operit2 Web Access static bundle.
# The threaded Sherpa ONNX WebAssembly runtime requires cross-origin
# isolation headers on every application asset response.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable
